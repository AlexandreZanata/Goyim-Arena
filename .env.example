# Goyim Arena — environment template.
#
# Copy to .env (git-ignored) and fill in real values there. Never commit
# real secrets: this file documents variables and safe examples only.

# Deployment environment: development | test | production
ARENA_ENV=development

# HTTP listen address (host:port). Development keeps the loopback default.
ARENA_ADDR=127.0.0.1:8080

# PostgreSQL DSN. In production this is REQUIRED and must point to the real
# database. The example below targets the local Compose service
# (compose.yaml): credentials are development-only, not reusable elsewhere.
ARENA_DATABASE_URL=postgres://arena:arena-local-dev@127.0.0.1:54329/arena?sslmode=disable

# Log verbosity: debug | info | warn | error
ARENA_LOG_LEVEL=info

# Database connection pool tuning (optional, safe defaults provided)
# ARENA_DB_MAX_CONNS=10
# ARENA_DB_MIN_CONNS=2
# ARENA_DB_MAX_CONN_LIFETIME=1h
# ARENA_DB_MAX_CONN_IDLE_TIME=30m
# ARENA_DB_ACQUIRE_TIMEOUT=5s

# Billing (P12-T01) — enabled commercial regions and the currency each one
# charges. Amounts are NOT configured here: they come from the versioned
# catalog shipped with the binary (internal/billing/adapters/catalog/
# products.json, from docs/MONETIZATION.md §4), so a price only changes with a
# reviewed catalog version. Empty by default: nothing is sellable until a
# region is enabled.
# ARENA_BILLING_MARKETS=BR:BRL,INTERNATIONAL:USD

# Billing — Stripe price ID of each catalog product, as MARKET/PRODUCT=PRICE_ID.
# Price IDs differ per Stripe account and mode, so they live only in the
# environment. In production (ARENA_ENV=production) every product of every
# enabled region is REQUIRED; in development and test an unset product simply
# cannot be sold yet.
# ARENA_BILLING_PRICE_IDS=BR/ink_10000=price_replace_me,BR/ink_40000=price_replace_me,BR/ink_100000=price_replace_me,BR/pass_1=price_replace_me,BR/pass_5=price_replace_me,BR/member_monthly=price_replace_me
