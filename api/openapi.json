{
  "openapi": "3.1.0",
  "info": {
    "title": "Goyim Arena API",
    "version": "0.1.0",
    "description": "Public HTTP contract of Goyim Arena. Versioned per the master plan: routes registered by the binary must match this document; the contract test fails on drift.",
    "summary": "Arena API contract"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Versioned API surface served by the arena binary."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "summary": "Liveness probe",
        "description": "Reports that the process is running. Never inspects dependencies: a wedged database must not make the supervisor restart a healthy-but-busy process.",
        "responses": {
          "200": {
            "description": "Process is alive.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "summary": "Readiness probe",
        "description": "Reports deployment readiness. Validates process, configuration and database connectivity when configured.",
        "responses": {
          "200": {
            "description": "Process, configuration and dependencies are ready.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          },
          "503": {
            "description": "One or more dependencies are unavailable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "authRegister",
        "summary": "Register a new account",
        "description": "Registers a new account. Prevents user enumeration by returning a uniform confirmation.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account registration initiated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegisterResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/auth/verify": {
      "get": {
        "operationId": "authVerify",
        "summary": "Verify account email",
        "description": "Verifies an account email using the single-use cryptographic verification token.",
        "tags": ["auth"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Single-use raw verification token.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Email verified successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" }
              },
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "authLogin",
        "summary": "Authenticate and create session",
        "description": "Authenticates credentials and establishes a new session, setting the arena_session cookie.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "summary": "Revoke active session",
        "description": "Revokes the active session and clears the arena_session cookie.",
        "tags": ["auth"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Logged out successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "operationId": "authRequestPasswordReset",
        "summary": "Request password recovery",
        "description": "Requests a password reset token. Anti-enumeration: returns 200 regardless of account existence.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email dispatched if account exists.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/auth/password-reset": {
      "get": {
        "operationId": "authViewPasswordReset",
        "summary": "Password reset landing page",
        "description": "Renders the password reset HTML form for email recovery links.",
        "tags": ["auth"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Password recovery token.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML form rendered.",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "authConfirmPasswordReset",
        "summary": "Complete password reset",
        "description": "Consumes the password recovery token, updates the credential, and revokes all active sessions.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetConfirm" }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/PasswordResetConfirm" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset complete.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" }
              },
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/me/profile": {
      "get": {
        "operationId": "getPrivateProfile",
        "summary": "Owner profile",
        "description": "Returns the profile projection of the authenticated owner. Private responses always carry Cache-Control: private, no-store (THR-CACHE-01).",
        "tags": ["profiles"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Private profile of the authenticated account.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PrivateProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/me/wallet": {
      "get": {
        "operationId": "getWalletBalance",
        "summary": "Derived INK balance",
        "description": "Returns the owner's INK bucket balances recomputed from the append-only ledger. Quantities are integer INK units (never floats, never pre-formatted money).",
        "tags": ["wallet"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Derived bucket balances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletBalance" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/me/wallet/transactions": {
      "get": {
        "operationId": "getWalletStatement",
        "summary": "Ledger statement",
        "description": "Returns the owner's ledger statement, newest first, as a cursor page. Entries carry the stable operation type, bucket, signed integer amount, reference and RFC 3339 UTC timestamp; administrative justifications, actors and antifraud details never serialize.",
        "tags": ["wallet"],
        "security": [{ "SessionCookie": [] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque server-signed cursor returned as next_cursor by the previous page.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (1..100); defaults to 20.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "One statement page.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletStatement" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/me/passes": {
      "get": {
        "operationId": "getArenaPassSummary",
        "summary": "Arena Pass summary",
        "description": "Returns the owner's Arena Pass summary: the derived available total and the private per-lot breakdown. Expiration is derived at the checked instant and expired lots are never counted as available.",
        "tags": ["passes"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Derived pass summary and private breakdown.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ArenaPassSummary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/me/passes/history": {
      "get": {
        "operationId": "getArenaPassHistory",
        "summary": "Arena Pass consumption history",
        "description": "Returns the owner's pass consumption history, newest first, as a cursor page. Entries carry the Arena identifier, the stable grant origin and reference and the RFC 3339 UTC instant; internal lot identifiers and provider payloads never serialize.",
        "tags": ["passes"],
        "security": [{ "SessionCookie": [] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque server-signed cursor returned as next_cursor by the previous page.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (1..100); defaults to 20.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "One consumption history page.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ArenaPassHistory" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/profiles/{username}": {
      "get": {
        "operationId": "getPublicProfile",
        "summary": "Public profile",
        "description": "Returns the public projection of a profile: username, interface locale and creation instant. Email, internal identifiers, payment data, antifraud flags and administrative notes are never part of this document.",
        "tags": ["profiles"],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Public username, matched case-insensitively.",
            "schema": { "type": "string", "minLength": 3, "maxLength": 30 }
          }
        ],
        "responses": {
          "200": {
            "description": "Public profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicProfile" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["pending_verification"] }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["status", "account_id"],
        "properties": {
          "status": { "type": "string", "enum": ["authenticated"] },
          "account_id": { "type": "string" }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "PasswordResetConfirm": {
        "type": "object",
        "required": ["token", "password"],
        "properties": {
          "token": { "type": "string" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" }
        }
      },
      "PublicProfile": {
        "type": "object",
        "description": "Public projection of a profile. Never contains email, internal identifiers, payment data, antifraud flags or administrative notes.",
        "required": ["username", "interface_locale", "created_at"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 30 },
          "interface_locale": { "type": "string", "enum": ["pt-BR", "en-US"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "PrivateProfile": {
        "type": "object",
        "description": "Owner projection of a profile. Adds only the mutation instant to the public fields; account, payment, antifraud and moderation data stay in their owning modules.",
        "required": ["username", "interface_locale", "created_at", "updated_at"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 30 },
          "interface_locale": { "type": "string", "enum": ["pt-BR", "en-US"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "WalletBalance": {
        "type": "object",
        "description": "INK bucket balances derived from the append-only ledger. Integer INK units: never floats and never pre-formatted money.",
        "required": ["balance_free", "balance_purchased"],
        "properties": {
          "balance_free": { "type": "integer", "minimum": 0, "description": "FREE_INK balance (plan franchise, consumed first)." },
          "balance_purchased": { "type": "integer", "minimum": 0, "description": "PURCHASED_INK balance (bought INK, consumed after the franchise)." }
        }
      },
      "WalletStatementEntry": {
        "type": "object",
        "description": "One ledger line of the owner statement. Restricted administrative reasons, actors and antifraud data are never part of this document.",
        "required": ["transaction_id", "operation_id", "operation_type", "bucket", "amount", "reference", "created_at"],
        "properties": {
          "transaction_id": { "type": "string" },
          "operation_id": { "type": "string" },
          "operation_type": {
            "type": "string",
            "enum": [
              "credit_free",
              "credit_member",
              "credit_purchase",
              "credit_refund",
              "credit_admin",
              "debit_argument",
              "debit_admin",
              "expire_free"
            ]
          },
          "bucket": { "type": "string", "enum": ["FREE_INK", "PURCHASED_INK"] },
          "amount": { "type": "integer", "description": "Signed INK delta: positive credits the bucket, negative debits it." },
          "reference": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "WalletStatement": {
        "type": "object",
        "description": "Cursor page of the owner ledger statement.",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/WalletStatementEntry" } },
          "next_cursor": { "type": ["string", "null"], "description": "Opaque signed cursor of the next page; null on the last page." }
        }
      },
      "ArenaPassLot": {
        "type": "object",
        "description": "Private breakdown entry of one Arena Pass lot: derived availability, grant origin and optional immutable expiration.",
        "required": ["origin", "quantity", "remaining", "expires_at", "expired", "created_at"],
        "properties": {
          "origin": { "type": "string", "enum": ["PURCHASE", "MEMBER", "ADMIN"] },
          "quantity": { "type": "integer", "minimum": 1 },
          "remaining": { "type": "integer", "minimum": 0 },
          "expires_at": { "type": ["string", "null"], "format": "date-time", "description": "Null when the lot never expires." },
          "expired": { "type": "boolean", "description": "Derived at the checked instant; expired lots are not counted as available." },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ArenaPassSummary": {
        "type": "object",
        "description": "Owner Arena Pass projection: available total plus the private per-lot breakdown.",
        "required": ["available_total", "checked_at", "lots"],
        "properties": {
          "available_total": { "type": "integer", "minimum": 0, "description": "Passes available at checked_at; expired lots are excluded." },
          "checked_at": { "type": "string", "format": "date-time" },
          "lots": { "type": "array", "items": { "$ref": "#/components/schemas/ArenaPassLot" } }
        }
      },
      "ArenaPassHistoryEntry": {
        "type": "object",
        "description": "One Arena Pass consumption of the owner history.",
        "required": ["consumption_id", "arena_id", "origin", "reference", "consumed_at"],
        "properties": {
          "consumption_id": { "type": "string" },
          "arena_id": { "type": "string" },
          "origin": { "type": "string", "enum": ["PURCHASE", "MEMBER", "ADMIN"] },
          "reference": { "type": "string" },
          "consumed_at": { "type": "string", "format": "date-time" }
        }
      },
      "ArenaPassHistory": {
        "type": "object",
        "description": "Cursor page of the owner pass consumption history.",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ArenaPassHistoryEntry" } },
          "next_cursor": { "type": ["string", "null"], "description": "Opaque signed cursor of the next page; null on the last page." }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["live", "ready", "unavailable"],
            "description": "Probe verdict."
          }
        }
      },
      "Problem": {
        "description": "RFC 9457 Problem Details document returned by every error response, with media type application/problem+json.",
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "Stable URI identifying the problem kind.",
            "examples": ["https://goyim.dev/problems/validation"]
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary, generic for internal errors."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code, identical to the response status."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, e.g. ARENA-validation."
          },
          "request_id": {
            "type": "string",
            "description": "Correlation ID echoed by the X-Request-Id middleware; join it with server logs."
          },
          "detail": {
            "type": "string",
            "description": "Public safe detail. Suppressed for internal errors: causes never serialize to clients."
          }
        }
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "arena_session",
        "description": "Opaque session token cookie (Secure, HttpOnly, SameSite). Sessions arrive with the identity phase; the scheme is declared now to anchor the contract."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Per-request CSRF token required by state-changing requests once sessions exist."
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Client-supplied correlation ID; validated (<=64 chars, [A-Za-z0-9_-]) and reused, or replaced by a generated one. Always echoed back.",
        "schema": { "type": "string", "maxLength": 64 }
      }
    },
    "responses": {
      "Validation": {
        "description": "Request validation failed.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated caller is not allowed to do this.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with the current state.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Internal": {
        "description": "Unexpected failure. The body stays generic; details go to logs, never to clients.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Correlation ID resolved by the request ID middleware.",
        "schema": { "type": "string", "maxLength": 64 }
      }
    }
  },
  "x-conventions": {
    "pagination": {
      "description": "List endpoints return cursor pages. Request: ?cursor=<opaque>&limit=<1..100>; limit defaults to 20. Response envelope: { items: [...], next_cursor: string|null }. Cursors are opaque, server-signed and never inspected by clients.",
      "cursorParameter": "cursor",
      "limitParameter": "limit",
      "limitDefault": 20,
      "limitMaximum": 100,
      "responseEnvelope": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    },
    "idempotency": {
      "description": "State-changing POST endpoints accept an Idempotency-Key header. Keys are scoped per session and endpoint, stored with the request fingerprint, and a replay returns the original result instead of re-executing the mutation. Responses carry Idempotency-Replayed: true on replays.",
      "header": "Idempotency-Key",
      "scope": "session+endpoint",
      "replayHeader": "Idempotency-Replayed"
    }
  },
